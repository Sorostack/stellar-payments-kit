{
  "name": "stellar-payments-kit",
  "version": "0.1.0",
  "description": "A lightweight TypeScript toolkit for building payment flows on the Stellar network.",
  "keywords": ["stellar", "payments", "blockchain", "typescript", "soroban", "xlm", "sdk"],
  "author": "Sorostack",
  "license": "MIT",
  "homepage": "https://github.com/Sorostack/stellar-payments-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sorostack/stellar-payments-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Sorostack/stellar-payments-kit/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "ci": "npm run check && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,mjs}": [
      "prettier --write"
    ]
  }
}
